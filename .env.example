# Demo mode is on by default: the dashboard renders src/lib/mock-data.ts
# with no keys required. Uncomment below and provide real credentials to
# switch a client's Organic Pulse tab from mock data to live GSC/GA4 data.
# (Not wired up yet — mock-first per the seo-geo-pulse plan.)

# GSC_SERVICE_ACCOUNT_JSON=./credentials/gsc-service-account.json
# GSC_SITE_URL=https://example.com/

# GA4_SERVICE_ACCOUNT_JSON=./credentials/ga4-service-account.json
# GA4_PROPERTY_ID=properties/000000000

# DataForSEO (AI Optimization + SERP APIs) — https://app.dataforseo.com/api-access
# Powers the "Use live DataForSEO data" toggle: AI Tracking's Visibility/Share of
# Voice/Citations, and Organic Pulse's Position column. Billed per request.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
